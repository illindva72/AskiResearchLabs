# Copy this file to .env and fill in your values

# Required for AI evaluation features
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: only if using a Perplexity proxy key (agp_...)
# ANTHROPIC_BASE_URL=https://agent-proxy.perplexity.ai/anthropic

# Optional: IEEE Institutional Credentials (for efficient full-text analysis extensions)
IEEE_USERNAME=your-institutional-email
IEEE_PASSWORD=your-institutional-password

# Admin / System Settings
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_EMAIL_PASSWORD=smtppassword  # Used for sending OTP emails

# Main Admin login
ADMIN_LOGIN_EMAIL=admin@researchtrack.app
ADMIN_PASSWORD=your-secure-admin-password
